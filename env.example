# Configure no Vercel > Project Settings > Environment Variables.
# Opção recomendada: JSON completo da conta de serviço Firebase em UMA linha.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"prosaude-e9130","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@prosaude-e9130.iam.gserviceaccount.com","client_id":"..."}

# Alternativa:
# FIREBASE_PROJECT_ID=prosaude-e9130
# FIREBASE_CLIENT_EMAIL=...
# FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
