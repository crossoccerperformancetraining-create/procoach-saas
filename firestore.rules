rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function anonymousAthlete() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    match /coachData/{coachId} {
      allow read, write: if signedIn() && request.auth.uid == coachId;
    }

    match /athletePortal/{accessToken} {
      allow read: if signedIn() && resource.data.active == true;

      allow create: if signedIn()
        && !anonymousAthlete()
        && request.resource.data.ownerUid == request.auth.uid;

      allow update: if signedIn() && (
        (!anonymousAthlete() && resource.data.ownerUid == request.auth.uid)
        ||
        (anonymousAthlete()
          && resource.data.active == true
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['responses', 'lastAthleteUpdate']))
      );

      allow delete: if signedIn()
        && !anonymousAthlete()
        && resource.data.ownerUid == request.auth.uid;
    }
  }
}
