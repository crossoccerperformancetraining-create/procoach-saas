rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth!=null;}
  function staff(data){return signedIn()&&(data.ownerUid==request.auth.uid||(request.auth.token.email!=null&&data.memberRoles[request.auth.token.email.lower()]!=null));}
  match /procoachProfiles/{uid}{allow read,write:if signedIn()&&request.auth.uid==uid;}
  match /coachData/{workspaceId}{
   // TRANSIÇÃO: leitura pública temporária para links antigos. REMOVA após migrar atletas para convite seguro.
   allow read: if true;
   allow create: if signedIn()&&request.resource.data.ownerUid==request.auth.uid;
   allow update,delete: if staff(resource.data);
   match /{sub=**}{allow read,write:if staff(get(/databases/$(database)/documents/coachData/$(workspaceId)).data);}
  }
 }
}