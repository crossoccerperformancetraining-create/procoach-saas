rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isCoach() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // GIFs, imagens e outros materiais enviados pela comissão.
    match /trainingMedia/{coachUid}/{allPaths=**} {
      allow read: if signedIn();
      allow write: if isCoach()
        && request.auth.uid == coachUid
        && request.resource.size < 25 * 1024 * 1024;
    }

    // Vídeos gravados/enviados pelo próprio atleta.
    match /athleteUploads/{athleteUid}/{allPaths=**} {
      allow read: if signedIn();
      allow write: if signedIn()
        && request.auth.uid == athleteUid
        && request.resource.size < 100 * 1024 * 1024
        && request.resource.contentType.matches('video/.*');
    }
  }
}
